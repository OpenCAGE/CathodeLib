<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/OpenCAGE/CathodeLib</RepositoryUrl>
    <PackageProjectUrl>https://github.com/MattFiler/OpenCAGE/</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageId>CathodeLib</PackageId>
    <Authors>Matt Filer</Authors>
    <Description>Provides support for parsing and writing common Alien: Isolation formats from the Cathode engine.</Description>
    <Copyright>Matt Filer 2026</Copyright>
    <Version>0.12.2</Version>
    <OutputType>Library</OutputType>
    <AssemblyVersion>0.12.2.0</AssemblyVersion>
    <FileVersion>0.12.2.0</FileVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>alien, modding, alien isolation, mod tool, file utility</PackageTags>
    <Title>CathodeLib</Title>
    <Configurations>Debug;Release;Ship</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants)TRACE;CATHODE_FAIL_HARD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Ship|AnyCPU'">
    <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CathodeBIN\NewFolder\**" />
    <EmbeddedResource Remove="CathodeBIN\NewFolder\**" />
    <None Remove="CathodeBIN\NewFolder\**" />
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AlienBML\BML.cs" Link="Scripts\CATHODE\BML.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DotRecast\src\DotRecast.Core\**\*.cs" Exclude="..\DotRecast\src\DotRecast.Core\bin\**;..\DotRecast\src\DotRecast.Core\obj\**" Link="Dependencies\DotRecast\Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\DotRecast\src\DotRecast.Recast\**\*.cs" Exclude="..\DotRecast\src\DotRecast.Recast\bin\**;..\DotRecast\src\DotRecast.Recast\obj\**" Link="Dependencies\DotRecast\Recast\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\DotRecast\src\DotRecast.Detour\**\*.cs" Exclude="..\DotRecast\src\DotRecast.Detour\bin\**;..\DotRecast\src\DotRecast.Detour\obj\**" Link="Dependencies\DotRecast\Detour\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\NanoRT\src\NanoRT\**\*.cs" Exclude="..\NanoRT\src\NanoRT\bin\**;..\NanoRT\src\NanoRT\obj\**" Link="Dependencies\NanoRT\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="5.0.0" />
    <PackageReference Include="xxHash.NET" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.6.2\PresentationCore.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\learned_cover.bin" LogicalName="CathodeLib.Learned.cover" />
    <EmbeddedResource Include="Resources\learned_spot.bin" LogicalName="CathodeLib.Learned.spot" />
    <EmbeddedResource Include="Resources\learned_assault.bin" LogicalName="CathodeLib.Learned.assault" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
